[Unit]
Description=Marketlab HTTP API
After=marketlab-postgres.service
Requires=marketlab-postgres.service

[Container]
ContainerName=marketlab-api
Image=@SERVICE_IMAGE_DIGEST@
Network=marketlab.network
EnvironmentFile=%h/.config/marketlab/api.env
PublishPort=127.0.0.1:8080:8080
UserNS=keep-id:uid=10001,gid=10001
Volume=/mnt/media/marketlab/raw/public-information:/mnt/media/marketlab/raw/public-information:ro,z
Volume=/mnt/stack/marketlab/social-features:/mnt/stack/marketlab/social-features:ro,z
Volume=/mnt/stack/marketlab/social-universe:/mnt/stack/marketlab/social-universe:ro,z
Volume=/mnt/stack/marketlab/models:/mnt/stack/marketlab/models:ro,z
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=512m
DropCapability=all
NoNewPrivileges=true
HealthCmd=/opt/marketlab/bin/service-health
HealthInterval=15s
HealthTimeout=5s
HealthRetries=8
HealthStartPeriod=30s
HealthOnFailure=kill
Notify=healthy
PodmanArgs=--cpus=1 --memory=2g --memory-swap=2g --pids-limit=256

[Service]
Environment=CONTAINERS_STORAGE_CONF=%h/.config/marketlab/storage.conf
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=default.target
