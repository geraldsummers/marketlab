[Unit]
Description=Marketlab persistent bounded Bluesky backfill shard A
After=network-online.target
StartLimitIntervalSec=0

[Service]
Environment=CONTAINERS_STORAGE_CONF=/home/gerald/.config/marketlab/storage.conf
ExecStart=/usr/bin/podman run --rm --replace \
  --name marketlab-backfill-social-a \
  --network=slirp4netns:allow_host_loopback=false \
  --read-only --cap-drop=all --security-opt=no-new-privileges \
  --userns=keep-id:uid=10001,gid=10001 \
  --cpus=10 --memory=24576m --memory-swap=24576m \
  --tmpfs=/tmp:rw,exec,nosuid,nodev,size=4g \
  --mount=type=bind,src=/mnt/media/marketlab/raw/social-backfill,dst=/mnt/media/marketlab/raw/social-backfill,rw=true,relabel=shared \
  --mount=type=bind,src=/mnt/stack/marketlab/models,dst=/mnt/stack/marketlab/models,ro=true,relabel=shared \
  localhost/marketlab-social-backfill@sha256:cffe44702c28d61be07292102b0f2ab38fe97d04a09b90ab533b161e6cdc238f \
  --output-root /mnt/media/marketlab/raw/social-backfill \
  --models-root /mnt/stack/marketlab/models \
  --model-lock /opt/marketlab/research/sentiment-models.lock.json \
  --program-lock /opt/marketlab/research/social-backfill-program.lock.json \
  --start 2025-10-04T00:00:00Z \
  --end 2026-07-01T00:00:00Z \
  --sources social \
  --assets BTC,SOL,HYPE,NEAR,PUMP
ExecStop=-/usr/bin/podman stop --time 30 marketlab-backfill-social-a
Restart=on-failure
RestartSec=15min
TimeoutStopSec=45

[Install]
WantedBy=default.target
